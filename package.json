{
  "name": "smart-bus-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node server/server.js",
    "build": "vite build",
    "test": "node --test",
    "seed": "node server/scripts/seed.js",
    "verify:rooms": "node server/scripts/verify-live-rooms.js",
    "verify:notifications": "node server/scripts/verify-notification-cycles.js",
    "gps-simulator": "node server/scripts/gps-simulator.js"
  },
  "dependencies": {
    "@firebase/app": "^0.16.2",
    "@firebase/messaging": "^0.13.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "uuid": "^11.1.1"
  }
}
