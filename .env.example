PORT=5000
MONGO_URI=replace-with-your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Restrict the backend key to the Routes API and your server.
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key
# Restrict the browser key to Maps JavaScript API and your website origins.
VITE_GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key

ETA_CACHE_TTL_SECONDS=60
BUS_APPROACHING_THRESHOLD_MINUTES=2
BUS_ARRIVAL_RADIUS_METERS=75
GPS_UPDATE_TIMEOUT_SECONDS=30
GPS_OFFLINE_TIMEOUT_SECONDS=120
GPS_SIMULATOR_INTERVAL_MS=5000
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Firebase Web app config (public browser values).
VITE_FIREBASE_API_KEY=replace-with-your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-your-firebase-app-id
VITE_FIREBASE_VAPID_KEY=replace-with-your-firebase-vapid-key

# Firebase Admin service account (private server-only values).
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-your-firebase-client-email
FIREBASE_PRIVATE_KEY=replace-with-your-firebase-private-key

SEED_ADMIN_EMAIL=admin@smartbus.local
SEED_ADMIN_PASSWORD=Admin@123
